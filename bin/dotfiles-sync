#!/bin/bash
# dotfiles-sync: keep this machine on origin/master and re-apply the installer.
#
#   dotfiles-sync            pull (ff on master, merge on a feature branch),
#                            push local master commits, run install.sh, reload
#                            Hyprland/tmux - only when something changed
#   dotfiles-sync --force    run the installer even if nothing changed
#
# Driven by dotfiles-sync.timer on every machine. Never force-pushes, never
# discards local changes: a merge that would touch dirty files is aborted and
# reported in the journal on every run, but with notify-send only once per
# problem (state in $XDG_STATE_HOME/dotfiles-sync/last-alert), so a blocked
# checkout does not raise a critical notification every 15 minutes.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/sync/src/dotfiles}"
MAIN=master
force=false
[[ "${1:-}" == "--force" ]] && force=true

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-sync"
LAST_ALERT="$STATE_DIR/last-alert"

desktop() {  # <urgency> <message>
  command -v notify-send >/dev/null && notify-send -a dotfiles-sync -u "$1" "dotfiles" "$2" 2>/dev/null || true
}

notify() {  # <urgency> <message>: informational, always shown
  echo "dotfiles-sync: $2"
  desktop "$1" "$2"
}

alert() {  # <urgency> <key> <message>: a problem; shown once per key, repeats go to the journal only
  echo "dotfiles-sync: $3"
  mkdir -p "$STATE_DIR"
  [[ "$(cat "$LAST_ALERT" 2>/dev/null)" == "$2" ]] && return 0
  printf '%s\n' "$2" > "$LAST_ALERT"
  desktop "$1" "$3"
}

resolved() {  # the last alerted problem is gone; say so once
  [[ -f "$LAST_ALERT" ]] || return 0
  rm -f "$LAST_ALERT"
  notify low "sync working again"
}

merge_failure() {  # <what> <err-file>: explain why a merge into the checkout failed
  local files
  if grep -q "would be overwritten" "$2"; then
    files="$(grep -P '^\t' "$2" | tr -d '\t' | paste -sd ' ')"
    echo "$1 blocked by uncommitted changes in: $files (commit or stash them)"
  else
    echo "$1 failed: $(tail -1 "$2")"
  fi
}

cd "$DOTFILES"
ERR="$(mktemp)"
trap 'rm -f "$ERR"' EXIT
git fetch -q origin "$MAIN" || { alert low fetch "fetch failed (offline?)"; exit 0; }

branch="$(git branch --show-current)"
before="$(git rev-parse HEAD)"
remote="$(git rev-parse "origin/$MAIN")"

if [[ "$branch" == "$MAIN" ]]; then
  if ! git merge-base --is-ancestor "$remote" HEAD; then
    if ! git merge -q --ff-only "origin/$MAIN" 2>"$ERR"; then
      ahead="$(git rev-list --count "origin/$MAIN..HEAD")"
      if [[ "$ahead" -gt 0 ]]; then
        alert critical "diverged:$remote" "master diverged from origin ($ahead local commit(s) not on origin): rebase or merge by hand"
      else
        alert critical "blocked:$remote" "$(merge_failure "update to origin/master" "$ERR")"
      fi
      exit 1
    fi
  fi
  # Push commits made here so the other machines pick them up.
  if [[ "$(git rev-list --count "origin/$MAIN..HEAD")" -gt 0 ]]; then
    git push -q origin "$MAIN" && echo "dotfiles-sync: pushed $(git rev-list --count "$remote..HEAD") commit(s)"
  fi
else
  # Feature branch (e.g. skrubben's reading-kobo-usb): carry master into it.
  if ! git merge-base --is-ancestor "$remote" HEAD; then
    if ! git merge -q --no-edit "origin/$MAIN" 2>"$ERR"; then
      git merge --abort 2>/dev/null || true
      alert critical "branch:$branch:$remote" "$(merge_failure "merge of origin/master into $branch" "$ERR")"
      exit 1
    fi
    git push -q origin "$branch" 2>/dev/null || true
  fi
fi

resolved
after="$(git rev-parse HEAD)"
if [[ "$after" == "$before" ]] && ! $force; then
  echo "dotfiles-sync: up to date ($(git log --oneline -1 | cut -c1-60))"
  exit 0
fi

if ! bash scripts/install.sh > /tmp/dotfiles-sync-install.log 2>&1; then
  alert critical "install:$(git rev-parse HEAD)" "install.sh failed, see /tmp/dotfiles-sync-install.log"
  exit 1
fi

# Reload what reads its config only at start.
if pgrep -x Hyprland >/dev/null; then
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)}"
  hyprctl reload >/dev/null 2>&1 || true
fi
tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null || true

n="$(git rev-list --count "$before..$after")"
notify low "applied $n commit(s): $(git log --oneline -1 | cut -c1-60)"

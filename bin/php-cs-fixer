#!/bin/bash
# Wrapper for php-cs-fixer that runs inside Docker when available
# Docker is preferred because vendor/bin tools target the container's PHP version

set -euo pipefail

HELPER="$(dirname "$(readlink -f "$0")")/php-container"
PROJECT_ROOT=""
CONTAINER=""
if DISCOVERED="$("$HELPER" 2>/dev/null)"; then
    PROJECT_ROOT="$(sed -n 1p <<<"$DISCOVERED")"
    CONTAINER="$(sed -n 2p <<<"$DISCOVERED")"
fi

if [[ -n "$CONTAINER" ]]; then
    # Translate file paths from host to container.
    # Conform creates temp files (.conform.PID.name.php) in the same directory as the
    # source file, which is accessible via the Docker volume mount at /srv.
    ARGS=()
    for arg in "$@"; do
        if [[ "$arg" == "$PROJECT_ROOT"* ]]; then
            ARGS+=("/srv${arg#"$PROJECT_ROOT"}")
        else
            ARGS+=("$arg")
        fi
    done

    exec docker exec -w /srv "$CONTAINER" \
        bash -c "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer $(printf '%q ' "${ARGS[@]}")"
fi

# Fallback: local vendor/bin
if [[ -n "$PROJECT_ROOT" && -x "$PROJECT_ROOT/vendor/bin/php-cs-fixer" ]]; then
    exec "$PROJECT_ROOT/vendor/bin/php-cs-fixer" "$@"
fi

# Fallback: global install
if command -v php-cs-fixer.phar &>/dev/null; then
    exec php-cs-fixer.phar "$@"
fi

echo "Error: php-cs-fixer not found (no Docker container, no local vendor/bin, no global install)" >&2
exit 1

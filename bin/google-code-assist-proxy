#!/usr/bin/env python3
"""Loopback Gemini API shim over Google Cloud Code Assist, using agy's OAuth session.

Pi talks to it with its native `google-generative-ai` API (full tool calling,
thinking, images): `POST /v1beta/models/<model>:streamGenerateContent?alt=sse`.
The shim wraps each request in the Code Assist envelope
`{project, model, user_prompt_id, request}`, sends it to
`<UPSTREAM>/v1internal:<method>` with the Antigravity OAuth bearer, and unwraps
the `{"response": ...}` envelope from every reply/SSE event. This mirrors the
Claude setup: the real API with the real credential, not a second agent.

Credentials (see $NOTES/Homelab/dotfiles/google-code-assist-proxy.md):
- Reads ~/.gemini/antigravity-cli/antigravity-oauth-token (owned by `agy`) and
  never writes it. When the access token is expired the shim refreshes it IN
  MEMORY with the stored refresh token and agy's own OAuth client (client id
  from the id_token `aud`; client secret located in the installed agy binary at
  runtime, or GOOGLE_ANTIGRAVITY_CLIENT_SECRET). Nothing is cached on disk.
- Tokens, request bodies and upstream payloads are never logged; the incoming
  API key (Pi's placeholder) is ignored. Listens on 127.0.0.1 only.

Extra endpoints: GET /health, GET /_usage (per-model quota, no secrets).
"""
from __future__ import annotations

import base64
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

TOKEN_FILE = Path(os.environ.get("AGY_TOKEN_FILE", Path.home() / ".gemini/antigravity-cli/antigravity-oauth-token"))
AGY_BINARY = Path(os.environ.get("AGY_BINARY", Path.home() / ".local/bin/agy"))
UPSTREAM = os.environ.get("GOOGLE_CODE_ASSIST_URL", "https://daily-cloudcode-pa.googleapis.com").rstrip("/")
HOST = os.environ.get("GOOGLE_CODE_ASSIST_HOST", "127.0.0.1")
PORT = int(os.environ.get("GOOGLE_CODE_ASSIST_PORT", "8790"))
PROJECT_OVERRIDE = os.environ.get("GOOGLE_CODE_ASSIST_PROJECT", "")
TOKEN_URL = "https://oauth2.googleapis.com/token"
LOOPBACK = {"127.0.0.1"}
MAX_BODY = 64 * 1024 * 1024
PATH_RE = re.compile(r"^(?:/v1beta|/v1)?/models/([A-Za-z0-9._-]+):(generateContent|streamGenerateContent|countTokens)$")
CLIENT_METADATA = {"ideType": "ANTIGRAVITY", "platform": "PLATFORM_UNSPECIFIED", "pluginType": "GEMINI"}


class Failure(Exception):
    """Error with an HTTP status and a message that is safe to return."""

    def __init__(self, status: int, message: str, reason: str = ""):
        super().__init__(message)
        self.status = status
        self.reason = reason


def _expiry_epoch(value) -> float:
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value).timestamp()
        except ValueError:
            return 0.0
    return 0.0


def _jwt_claims(token: str) -> dict:
    try:
        payload = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    except (IndexError, ValueError):
        return {}


class Session:
    """In-memory OAuth + project state. Never writes agy's credential file."""

    def __init__(self):
        self.lock = threading.Lock()
        self.access = ""
        self.expires = 0.0
        self.file_mtime = 0.0
        self.project = PROJECT_OVERRIDE

    def _read_file(self) -> dict:
        try:
            data = json.loads(TOKEN_FILE.read_text())
            token = data.get("token", data)
            if not token.get("access_token") and not token.get("refresh_token"):
                raise KeyError
            return data
        except (OSError, ValueError, KeyError, AttributeError):
            raise Failure(503, "No Antigravity OAuth session found; run `agy` and sign in.") from None

    def _client_secrets(self) -> list[str]:
        env = os.environ.get("GOOGLE_ANTIGRAVITY_CLIENT_SECRET")
        if env:
            return [env]
        try:
            blob = AGY_BINARY.read_bytes()
        except OSError:
            return []
        return sorted({m.decode() for m in re.findall(rb"GOCSPX-[A-Za-z0-9_-]{28}", blob)})

    def _refresh(self, data: dict) -> None:
        token = data.get("token", data)
        refresh = token.get("refresh_token")
        client_id = _jwt_claims(data.get("id_token", "")).get("aud") or os.environ.get("GOOGLE_ANTIGRAVITY_CLIENT_ID")
        if not refresh or not client_id:
            raise Failure(503, "Antigravity access token expired and cannot be refreshed; run `agy` once.")
        for secret in self._client_secrets():
            body = urllib.parse.urlencode({"grant_type": "refresh_token", "refresh_token": refresh,
                                           "client_id": client_id, "client_secret": secret}).encode()
            try:
                with urllib.request.urlopen(TOKEN_URL, body, timeout=20) as response:
                    result = json.loads(response.read())
            except urllib.error.HTTPError as error:
                if error.code in (400, 401):
                    continue
                raise Failure(502, f"Google token refresh failed (HTTP {error.code}).") from None
            except urllib.error.URLError:
                raise Failure(502, "Google token endpoint unreachable.") from None
            if result.get("access_token"):
                self.access = result["access_token"]
                self.expires = time.time() + int(result.get("expires_in") or 3600)
                return
        raise Failure(503, "Antigravity token refresh was rejected; run `agy` once to sign in again.")

    def token(self, force: bool = False) -> str:
        with self.lock:
            try:
                mtime = TOKEN_FILE.stat().st_mtime
            except OSError:
                mtime = 0.0
            if mtime != self.file_mtime:  # agy refreshed or re-logged in: prefer its token
                data = self._read_file()
                token = data.get("token", data)
                self.file_mtime = mtime
                self.access = token.get("access_token", "")
                self.expires = _expiry_epoch(token.get("expiry"))
            if force or not self.access or self.expires <= time.time() + 60:
                self._refresh(self._read_file())
            return self.access

    def project_id(self) -> str:
        if self.project:
            return self.project
        info = internal("loadCodeAssist", {"metadata": CLIENT_METADATA})
        project = info.get("cloudaicompanionProject")
        if isinstance(project, dict):
            project = project.get("id")
        if not project:
            raise Failure(503, "Code Assist returned no project for this account; run `agy` once to onboard.")
        self.project = str(project)
        return self.project


SESSION = Session()


def _request(method: str, body: dict, stream: bool = False, retry: bool = True):
    url = f"{UPSTREAM}/v1internal:{method}" + ("?alt=sse" if stream else "")
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": "Bearer " + SESSION.token(), "Content-Type": "application/json",
        "Accept": "text/event-stream" if stream else "application/json",
        "User-Agent": "antigravity", "x-activity-request-id": str(uuid.uuid4())})
    try:
        return urllib.request.urlopen(req, timeout=900)
    except urllib.error.HTTPError as error:
        if error.code == 401 and retry:
            SESSION.token(force=True)
            return _request(method, body, stream, retry=False)
        raise upstream_failure(error) from None
    except urllib.error.URLError:
        raise Failure(502, "Google Cloud Code Assist unreachable.") from None


def upstream_failure(error: urllib.error.HTTPError) -> Failure:
    """Keep Google's status/message/reason (Pi needs 429/503 semantics); drop everything else."""
    message, reason = f"Google Cloud Code Assist HTTP {error.code}", ""
    try:
        detail = json.loads(error.read(65536)).get("error", {})
        message = str(detail.get("message") or message)[:500]
        for item in detail.get("details") or []:
            if isinstance(item, dict) and item.get("reason"):
                reason = str(item["reason"])
    except (ValueError, AttributeError, OSError):
        pass
    return Failure(error.code, message, reason)


def internal(method: str, body: dict) -> dict:
    with _request(method, body) as response:
        return json.loads(response.read())


def envelope(model: str, request: dict) -> dict:
    request = {k: v for k, v in request.items() if k != "model"}
    return {"project": SESSION.project_id(), "model": model, "user_prompt_id": str(uuid.uuid4()), "request": request}


def unwrap(payload):
    return payload["response"] if isinstance(payload, dict) and isinstance(payload.get("response"), dict) else payload


def usage() -> dict:
    data = internal("fetchAvailableModels", {"project": SESSION.project_id()})
    models = {}
    for name, info in (data.get("models") or {}).items():
        quota = info.get("quotaInfo") or {}
        models[name] = {"display_name": info.get("displayName"), "remaining_fraction": quota.get("remainingFraction"),
                        "reset_time": quota.get("resetTime"), "max_tokens": info.get("maxTokens"),
                        "max_output_tokens": info.get("maxOutputTokens"),
                        "supports_images": info.get("supportsImages"), "supports_thinking": info.get("supportsThinking")}
    return {"provider": "google-antigravity", "checked_at": int(time.time()), "models": models}


class Handler(BaseHTTPRequestHandler):
    server_version = "google-code-assist-proxy"
    protocol_version = "HTTP/1.1"

    def log_message(self, *_args):  # never log: paths are harmless but bodies/headers are not
        pass

    def _json(self, status: int, obj: dict) -> None:
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _error(self, failure: Failure) -> None:
        error = {"code": failure.status, "message": str(failure), "status": "PROXY_ERROR"}
        if failure.reason:
            error["details"] = [{"@type": "type.googleapis.com/google.rpc.ErrorInfo", "reason": failure.reason}]
        self._json(failure.status, {"error": error})

    def do_GET(self):
        try:
            if self.path == "/health":
                self._json(200, {"status": "ok", "upstream": UPSTREAM})
            elif self.path == "/_usage":
                self._json(200, usage())
            else:
                self._json(404, {"error": {"code": 404, "message": "not found"}})
        except Failure as failure:
            self._error(failure)

    def do_POST(self):
        match = PATH_RE.match(urllib.parse.urlsplit(self.path).path)
        if not match:
            self._json(404, {"error": {"code": 404, "message": "not found"}})
            return
        model, method = match.groups()
        try:
            length = int(self.headers.get("content-length") or 0)
            if length <= 0 or length > MAX_BODY:
                raise Failure(400, "Missing or oversized request body.")
            try:
                request = json.loads(self.rfile.read(length))
            except ValueError:
                raise Failure(400, "Request body is not JSON.") from None
            if not isinstance(request, dict):
                raise Failure(400, "Request body must be a JSON object.")
            if method == "countTokens":
                body = {"request": {"model": f"models/{model}", "contents": request.get("contents", [])}}
                self._json(200, unwrap(internal("countTokens", body)))
                return
            upstream = _request(method, envelope(model, request), stream=method == "streamGenerateContent")
        except Failure as failure:
            self._error(failure)
            return
        except Exception as error:  # noqa: BLE001 - exception text may contain request data
            self._json(500, {"error": {"code": 500, "message": f"proxy error ({type(error).__name__})"}})
            return
        with upstream:
            if method == "generateContent":
                self._json(200, unwrap(json.loads(upstream.read())))
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            try:
                for line in upstream:
                    if not line.startswith(b"data:"):
                        continue
                    raw = line[5:].strip()
                    if not raw:
                        continue
                    try:
                        event = unwrap(json.loads(raw))
                    except ValueError:
                        continue
                    self.wfile.write(b"data: " + json.dumps(event).encode() + b"\r\n\r\n")
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass


def serve(host: str = HOST, port: int = PORT) -> ThreadingHTTPServer:
    if host not in LOOPBACK:
        raise SystemExit(f"refusing non-loopback bind address {host!r}")
    server = ThreadingHTTPServer((host, port), Handler)
    server.daemon_threads = True
    return server


if __name__ == "__main__":
    try:
        serve().serve_forever()
    except KeyboardInterrupt:
        sys.exit(0)

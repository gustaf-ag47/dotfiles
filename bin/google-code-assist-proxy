#!/usr/bin/env python3
"""EXPERIMENTAL loopback OpenAI-compatible proxy for Google Cloud Code Assist.

Lets Pi talk to Gemini through the OAuth session that the Antigravity CLI
(`agy`) already holds in ~/.gemini/antigravity-cli/antigravity-oauth-token.
See docs/google-code-assist-proxy.md for scope and limitations.

Safety contract:
- Listens on 127.0.0.1 only; any other bind address is refused.
- Text-only chat completions. Requests carrying tools, tool calls, tool
  results or non-text content are rejected with HTTP 400 — this proxy never
  claims tool support it does not have.
- The OAuth credential is read-only here: never refreshed, written, logged
  or echoed. Upstream error bodies are not forwarded (they can echo request
  data); only the status code is reported.
- The `agy` fallback (used when Google refuses the token for direct
  inference, e.g. consumer accounts get 403 SUBSCRIPTION_REQUIRED) runs a
  second agent process. It is OFF unless GOOGLE_CODE_ASSIST_AGY_FALLBACK=1,
  and then runs sandboxed with slash commands disabled inside an empty
  temporary directory (agy ignores --mode plan when slash commands are off).
"""
from __future__ import annotations

import datetime
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

TOKEN_FILE = Path(os.environ.get("AGY_TOKEN_FILE", Path.home() / ".gemini/antigravity-cli/antigravity-oauth-token"))
UPSTREAM = os.environ.get("GOOGLE_CODE_ASSIST_URL", "https://cloudcode-pa.googleapis.com")
HOST = os.environ.get("GOOGLE_CODE_ASSIST_HOST", "127.0.0.1")
PORT = int(os.environ.get("GOOGLE_CODE_ASSIST_PORT", "8790"))
PROJECT = os.environ.get("GOOGLE_CODE_ASSIST_PROJECT", "default-cli-project")
DEFAULT_MODEL = "gemini-3.8-flash-low"
LOOPBACK = {"127.0.0.1"}
MAX_BODY = 16 * 1024 * 1024


class Rejected(Exception):
    """Client error with a message that is safe to return."""

    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status


def fallback_enabled() -> bool:
    return os.environ.get("GOOGLE_CODE_ASSIST_AGY_FALLBACK") == "1"


def access_token() -> str:
    """Read agy's access token. Never refreshes: run `agy` to renew it."""
    try:
        data = json.loads(TOKEN_FILE.read_text())
        token = data.get("token", data)
        access = token["access_token"]
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        raise Rejected(503, "No Antigravity OAuth session found; run `agy` and sign in.") from None
    expiry = token.get("expiry")
    if isinstance(expiry, str):
        try:
            if datetime.datetime.fromisoformat(expiry).timestamp() <= time.time() + 30:
                raise Rejected(503, "Antigravity OAuth access token expired; run `agy` once to refresh it.")
        except ValueError:
            pass
    return access


def text_of(content) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        out = []
        for part in content:
            if not isinstance(part, dict) or part.get("type") != "text":
                raise Rejected(400, "Non-text content is not supported by the experimental google-cloud-code provider.")
            out.append(str(part.get("text", "")))
        return "\n".join(out)
    raise Rejected(400, "Unsupported message content.")


def validate(body) -> None:
    """Reject anything this proxy cannot faithfully serve."""
    if not isinstance(body, dict) or not isinstance(body.get("messages"), list) or not body["messages"]:
        raise Rejected(400, "Expected a chat completion request with a non-empty messages list.")
    if body.get("tools") or body.get("functions") or body.get("tool_choice") not in (None, "none"):
        raise Rejected(400, "Tool calling is not supported by the experimental google-cloud-code provider; "
                            "run Pi with --no-tools or pick another provider.")
    for message in body["messages"]:
        if not isinstance(message, dict):
            raise Rejected(400, "Malformed message.")
        if message.get("role") not in ("system", "developer", "user", "assistant"):
            raise Rejected(400, "Tool results are not supported by the experimental google-cloud-code provider.")
        if message.get("tool_calls") or message.get("function_call"):
            raise Rejected(400, "Tool calls are not supported by the experimental google-cloud-code provider.")
        text_of(message.get("content"))


def request_body(body) -> dict:
    system, contents = [], []
    for message in body["messages"]:
        content = text_of(message.get("content"))
        if message["role"] in ("system", "developer"):
            system.append(content)
        elif content:
            contents.append({"role": "model" if message["role"] == "assistant" else "user", "parts": [{"text": content}]})
    inner: dict = {"contents": contents}
    if system:
        inner["systemInstruction"] = {"role": "system", "parts": [{"text": "\n\n".join(system)}]}
    config = {}
    for src, dst in (("temperature", "temperature"), ("top_p", "topP"),
                     ("max_tokens", "maxOutputTokens"), ("max_completion_tokens", "maxOutputTokens")):
        if isinstance(body.get(src), (int, float)) and not isinstance(body.get(src), bool):
            config[dst] = body[src]
    if config:
        inner["generationConfig"] = config
    return {"project": PROJECT, "model": body.get("model") or DEFAULT_MODEL,
            "user_prompt_id": str(uuid.uuid4()), "request": inner}


def direct(body) -> dict:
    req = urllib.request.Request(
        UPSTREAM + "/v1internal:generateContent", data=json.dumps(request_body(body)).encode(), method="POST",
        headers={"Authorization": "Bearer " + access_token(), "Content-Type": "application/json",
                 "Accept": "application/json", "User-Agent": "google-api-nodejs-client/9.15.1 (gzip)",
                 "X-Goog-Api-Client": "gl-node/24.0.0", "x-activity-request-id": str(uuid.uuid4())})
    with urllib.request.urlopen(req, timeout=600) as response:
        return json.loads(response.read())


def agy_prompt(body) -> str:
    parts = []
    for message in body["messages"]:
        parts.append(f"[{message['role']}]\n{text_of(message.get('content'))}")
    return "\n\n".join(parts)


def via_agy(body) -> dict:
    model = body.get("model") or DEFAULT_MODEL
    with tempfile.TemporaryDirectory(prefix="gca-agy-") as empty:
        result = subprocess.run(
            ["agy", "--model", model, "--sandbox", "--disable-slash-commands",
             "-p=" + agy_prompt(body)],
            cwd=empty, capture_output=True, text=True, timeout=600)
    if result.returncode != 0:
        # agy stderr is not echoed: it may contain conversation text.
        raise Rejected(502, f"agy fallback failed (exit {result.returncode}).")
    return {"response": {"candidates": [{"content": {"parts": [{"text": result.stdout}]}}]}}


def generate(body) -> dict:
    try:
        return direct(body)
    except urllib.error.HTTPError as error:
        if error.code in (401, 403) and fallback_enabled():
            return via_agy(body)
        hint = "" if fallback_enabled() else " (set GOOGLE_CODE_ASSIST_AGY_FALLBACK=1 to route through agy)"
        raise Rejected(502, f"Google Cloud Code Assist returned HTTP {error.code}{hint}.") from None
    except urllib.error.URLError:
        raise Rejected(502, "Google Cloud Code Assist unreachable.") from None


def completion(raw: dict, model: str) -> dict:
    inner = raw.get("response", raw) if isinstance(raw, dict) else {}
    candidates = inner.get("candidates") or [{}]
    parts = (candidates[0].get("content") or {}).get("parts") or []
    content = "".join(p.get("text", "") for p in parts if isinstance(p, dict) and not p.get("thought"))
    meta = inner.get("usageMetadata") or {}
    prompt, output = int(meta.get("promptTokenCount") or 0), int(meta.get("candidatesTokenCount") or 0)
    return {"id": "chatcmpl-" + uuid.uuid4().hex, "object": "chat.completion", "created": int(time.time()),
            "model": model, "choices": [{"index": 0, "message": {"role": "assistant", "content": content},
                                         "finish_reason": "stop"}],
            "usage": {"prompt_tokens": prompt, "completion_tokens": output, "total_tokens": prompt + output}}


def sse_chunks(result: dict) -> list[bytes]:
    base = {"id": result["id"], "object": "chat.completion.chunk", "created": result["created"], "model": result["model"]}
    chunks = []
    content = result["choices"][0]["message"]["content"]
    if content:
        chunks.append({**base, "choices": [{"index": 0, "delta": {"role": "assistant", "content": content},
                                            "finish_reason": None}]})
    chunks.append({**base, "choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}], "usage": result["usage"]})
    return [b"data: " + json.dumps(c).encode() + b"\n\n" for c in chunks] + [b"data: [DONE]\n\n"]


class Handler(BaseHTTPRequestHandler):
    server_version = "google-code-assist-proxy"

    def log_message(self, *_args):  # no request logging: bodies/headers may hold secrets
        pass

    def _json(self, status: int, obj: dict) -> None:
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            self._json(200, {"status": "ok", "experimental": True, "tools": False,
                             "agy_fallback": fallback_enabled()})
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if self.path.rstrip("/") not in ("/v1/chat/completions", "/chat/completions"):
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("content-length") or 0)
            if length <= 0 or length > MAX_BODY:
                raise Rejected(400, "Missing or oversized request body.")
            try:
                body = json.loads(self.rfile.read(length))
            except ValueError:
                raise Rejected(400, "Request body is not JSON.") from None
            validate(body)
            result = completion(generate(body), body.get("model") or DEFAULT_MODEL)
        except Rejected as error:
            self._json(error.status, {"error": {"message": str(error), "type": "google_cloud_code_proxy"}})
            return
        except Exception as error:  # noqa: BLE001 - never leak exception text (may hold request data)
            self._json(500, {"error": {"message": f"proxy error ({type(error).__name__})"}})
            return
        if body.get("stream"):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            for chunk in sse_chunks(result):
                self.wfile.write(chunk)
            self.wfile.flush()
        else:
            self._json(200, result)


def serve(host: str = HOST, port: int = PORT) -> ThreadingHTTPServer:
    if host not in LOOPBACK:
        raise SystemExit(f"refusing non-loopback bind address {host!r}")
    return ThreadingHTTPServer((host, port), Handler)


if __name__ == "__main__":
    try:
        serve().serve_forever()
    except KeyboardInterrupt:
        sys.exit(0)

#!/usr/bin/env python3
"""One bounded stall-watchdog tick; exit 10 keeps watch-child monitoring a stalled lane."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

BUSY = re.compile(r"[⠀-⣿] Working|Working\.\.\.|esc to interrupt")
PARKED = re.compile(r"[\w.-]+: BLOCKER [0-9a-fA-F]{7,40}|[\w.-]+: BLOCKER none - ")


def command(args, cwd=None):
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True, timeout=30, check=False)
    if result.returncode:
        raise ValueError(result.stderr.strip() or f"command failed: {args[0]}")
    return result.stdout


def parked(child, mailbox):
    lane = re.escape(child.split(":")[-1])
    result = re.compile(rf"^\s*{lane}: (BLOCKER|DONE|PASS|FAILED) ", re.MULTILINE)
    latest = None
    for record in [p for directory in (mailbox, mailbox / "ack") for p in directory.glob("*") if p.suffix in (".mail", ".md")]:
        try:
            match = result.search(record.read_text(errors="replace"))
            stamp = record.stat().st_mtime
        except OSError:
            continue
        if match and (latest is None or stamp > latest[0]):
            latest = (stamp, match.group(1))
    if latest:
        return latest[1] == "BLOCKER"
    history = command(["tmux", "capture-pane", "-J", "-p", "-S", "-3000", "-t", child])
    return bool(PARKED.search(history))


def notify(sid, message):
    if not sid:
        return  # legacy lane: no pane fallback
    target = f"session:{sid}"
    sender = Path(__file__).resolve().with_name("delegate-send")
    command([str(sender), target, "--text", message])


def tick(manifest, child, parent):
    lane = json.loads(manifest.read_text())
    parent_sid = lane.get("parent_session_id")
    child_sid = lane.get("child_session_id")
    cwd = lane.get("cwd")
    if not cwd:
        return 0
    command(["git", "rev-parse", "--git-dir"], cwd)
    mailbox = Path(os.environ.get("PI_DELEGATE_MAILBOX", Path.home() / ".pi/agent/delegate-mailbox"))
    directory = mailbox / "watchdog"
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / (manifest.stem + ".json")
    state = json.loads(path.read_text()) if path.exists() else {}
    now = time.time()
    interval = float(os.environ.get("PI_DELEGATE_STALL_POLL_SECS", "60"))
    if now - state.get("checked_at", 0) < interval:
        return 10 if state.get("stalled") else 0
    pane = command(["tmux", "capture-pane", "-J", "-p", "-t", child])
    idle_or_waiting = not BUSY.search(pane) or bool(re.search(r"ci_wait|CI watch|CI WAIT", pane))
    args = ["gh", "pr", "view"]
    if lane.get("pr"):
        args.append(str(lane["pr"]))
    args += ["--json", "number,url,mergeStateStatus,headRefOid,state,isDraft"]
    pr = json.loads(command(args, cwd))
    reason = pr["mergeStateStatus"] if pr["mergeStateStatus"] in ("DIRTY", "BEHIND") else ""
    # Draft CI may deliberately fail verdict jobs without running tests. Those
    # failures are not a stall; real DIRTY/BEHIND conflicts remain actionable.
    if not reason and pr["state"] == "OPEN" and not pr.get("isDraft", False):
        checks_args = ["gh", "pr", "checks", str(pr["number"]), "--required", "--json", "name,bucket"]
        checks = subprocess.run(checks_args, cwd=cwd, text=True, capture_output=True, timeout=30, check=False)
        # Repositories without required contexts still have CI gates. Check all
        # reported jobs there; permission/network failures are not green evidence.
        if "no required checks" in checks.stderr.lower():
            checks_args.remove("--required")
            checks = subprocess.run(checks_args, cwd=cwd, text=True, capture_output=True, timeout=30, check=False)
        if checks.returncode not in (0, 1, 8):
            raise ValueError(checks.stderr or "checks unavailable")
        data = json.loads(checks.stdout)
        # Only the newest check-run per name gates the merge. `gh pr checks` also
        # lists check-runs from runs that CI concurrency cancelled when a newer
        # push arrived; those show as "cancel" (or stale "fail") next to the live
        # "pending"/"pass" entry of the same name. Drop a name that has any
        # non-terminal or passing sibling, and never count a lone cancel as red.
        by_name: dict[str, set[str]] = {}
        for check in data:
            by_name.setdefault(check["name"], set()).add(check.get("bucket", ""))
        failed = sorted(
            name for name, buckets in by_name.items()
            if "fail" in buckets and not buckets & {"pass", "pending", "skipping"}
        )
        if failed:
            reason = "red: " + ", ".join(failed)
    stalled = bool(idle_or_waiting and reason and pr["state"] == "OPEN")
    if stalled:
        signature = f"{pr['headRefOid']}:{reason}"
        if state.get("signature") != signature or not state.get("stalled"):
            if parked(child, mailbox):
                notify(parent_sid, f"Child {child} is parked on BLOCKER; PR #{pr['number']} {reason} is left for the operator's decision. {pr['url']} (lane {manifest.stem})")
            else:
                notify(parent_sid, f"Child {child} stalled: PR #{pr['number']} {reason}. {pr['url']} (lane {manifest.stem})")
                notify(child_sid, f"Rebase/fix: PR #{pr['number']} is {reason}. Resolve the blocker, rerun gates and verify CI before claiming done. {pr['url']}")
            state.update(signature=signature, stalled_since=now, parent_alerted=False)
        parent_pane = command(["tmux", "capture-pane", "-J", "-p", "-t", parent])
        if BUSY.search(parent_pane):
            state["parent_idle_since"] = None
        else:
            state["parent_idle_since"] = state.get("parent_idle_since") or now
            minutes = float(os.environ.get("PI_DELEGATE_PARENT_IDLE_MINUTES", "10"))
            if now - state["parent_idle_since"] >= minutes * 60 and not state.get("parent_alerted"):
                notify(parent_sid, f"Orchestrator idle while child {child} remains stalled for PR #{pr['number']} {reason}. Take ownership of the blocker. {pr['url']}")
                state["parent_alerted"] = True
    else:
        state.pop("parent_idle_since", None)
        state.pop("signature", None)
        state.pop("stalled_since", None)
        state.pop("parent_alerted", None)
    state.update(checked_at=now, stalled=stalled, pr=pr["url"], reason=reason)
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(state) + "\n")
    temp.replace(path)
    return 10 if stalled else 0


def main():
    try:
        return tick(Path(sys.argv[1]), sys.argv[2], sys.argv[3])
    except (OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError) as error:
        print(f"delegate-watchdog: unable to assess lane: {error}", file=sys.stderr)
        return 0  # Do not invent a stall verdict when discovery fails.


if __name__ == "__main__":
    raise SystemExit(main())

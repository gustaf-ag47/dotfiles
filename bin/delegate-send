#!/usr/bin/env python3
"""Queue a literal steering payload for a Pi pane, without typing keystrokes."""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import uuid


def atomic_write(path, text):
    fd, tmp = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", help="tmux session:window or %%pane")
    payload = parser.add_mutually_exclusive_group(required=True)
    payload.add_argument("--file", type=Path)
    payload.add_argument("--text")
    args = parser.parse_args()
    try:
        command = (["tmux", "display-message", "-p", "-t", args.target, "#{pane_id}"]
                   if re.fullmatch(r"%\d+", args.target)
                   else ["tmux", "list-panes", "-t", args.target, "-F", "#{pane_id}"])
        panes = subprocess.check_output(command, text=True).splitlines()
        if len(panes) != 1 or not re.fullmatch(r"%\d+", panes[0]):
            parser.error("target must resolve to exactly one pane; specify %pane for split windows")
        message = args.file.read_text() if args.file else args.text
        if not message.strip():
            parser.error("message must not be empty")
        mailbox = Path(os.environ.get("PI_DELEGATE_MAILBOX", Path.home() / ".pi/agent/delegate-mailbox"))
        mailbox.mkdir(parents=True, exist_ok=True)
        (mailbox / "state").mkdir(exist_ok=True)
        name = f"steer-{uuid.uuid4().hex}.md"
        now = datetime.datetime.now(datetime.timezone.utc).isoformat()
        record = (f"# Delegation steering\n- parent: `{panes[0]}`\n- kind: `steer`\n"
                  f"- created: `{now}`\n\n{message}\n")
        atomic_write(mailbox / "state" / f"{name}.json", json.dumps({"state": "queued", "pane": panes[0], "at": now}) + "\n")
        atomic_write(mailbox / name, record)
        print(mailbox / name)
    except (OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"delegate-send: {error}\n")


if __name__ == "__main__":
    main()

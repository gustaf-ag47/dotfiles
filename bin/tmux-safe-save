#!/bin/bash
# tmux-safe-save: Wrapper around tmux-resurrect save that prevents empty saves
# This prevents the common issue where rebooting with no sessions creates an empty save file
# that overwrites the last good save.

set -euo pipefail

RESURRECT_SCRIPT="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tmux-resurrect/scripts/save.sh"

# Check if there are any sessions to save
session_count=$(tmux list-sessions 2>/dev/null | wc -l)

if [ "$session_count" -eq 0 ]; then
    echo "No tmux sessions to save, skipping to prevent empty save file"
    exit 0
fi

# Check if the only session is a default empty one (e.g., session "0" with 1 window at home dir)
# This helps prevent saving useless sessions created by continuum on empty restore
if [ "$session_count" -eq 1 ]; then
    session_info=$(tmux list-sessions -F "#{session_name}:#{session_windows}" 2>/dev/null)
    session_name="${session_info%%:*}"
    window_count="${session_info##*:}"

    # If the only session is auto-numbered (0, 1, 2...) with 1 window, it's likely
    # a bare session created by ftmuxp or continuum before real work has started
    if [[ "$session_name" =~ ^[0-9]+$ ]] && [ "$window_count" = "1" ]; then
        echo "Only default session '$session_name' exists, skipping save to preserve last good backup"
        exit 0
    fi
fi

# Remember the previous "last" snapshot so we can detect a catastrophic shrink
# (e.g. the server died and automation recreated a near-empty skeleton \u2014 the
# 2026-10-07 incident: a 91-pane save was superseded by a 1-pane save, so the
# subsequent restore resurrected empty windows).
resurrect_dir="$(tmux show-option -gqv @resurrect-dir 2>/dev/null)"
resurrect_dir="${resurrect_dir:-$HOME/.tmux/resurrect}"
resurrect_dir="$(eval echo "$resurrect_dir")"  # expand $HOME in the option value
prev_file=""
prev_panes=0
if [ -L "$resurrect_dir/last" ]; then
    prev_file="$(readlink -f "$resurrect_dir/last")"
    prev_panes=$(grep -c '^pane' "$prev_file" 2>/dev/null || echo 0)
fi

# Run the actual save script
if [ -x "$RESURRECT_SCRIPT" ]; then
    "$RESURRECT_SCRIPT"
else
    echo "Error: tmux-resurrect save script not found at $RESURRECT_SCRIPT"
    exit 1
fi

# Shrink guard: if the new snapshot has fewer than half the panes of the
# previous one (and the previous one was non-trivial), keep the new file on
# disk but point "last" back at the previous good snapshot so a restore never
# resurrects a post-crash skeleton.
if [ -n "$prev_file" ] && [ "$prev_panes" -ge 10 ] && [ -L "$resurrect_dir/last" ]; then
    new_file="$(readlink -f "$resurrect_dir/last")"
    if [ "$new_file" != "$prev_file" ]; then
        new_panes=$(grep -c '^pane' "$new_file" 2>/dev/null || echo 0)
        if [ "$new_panes" -lt "$((prev_panes / 2))" ]; then
            ln -sf "$(basename "$prev_file")" "$resurrect_dir/last"
            echo "WARNING: new save has $new_panes panes vs previous $prev_panes;" \
                 "kept 'last' -> $(basename "$prev_file") (new save retained as $(basename "$new_file"))"
        fi
    fi
fi

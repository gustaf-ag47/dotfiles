#!/bin/bash

# Terminal Calculator Popup
# Opens a floating terminal with a calculator

# Calculator script content
CALC_SCRIPT="
import math
import sys
import readline
import atexit
import os

# Setup readline history
histfile = os.path.join(os.path.expanduser('~'), '.calc_history')
try:
    readline.read_history_file(histfile)
    readline.set_history_length(100)
except FileNotFoundError:
    pass

atexit.register(readline.write_history_file, histfile)

# Define useful constants and functions
pi = math.pi
e = math.e
sqrt = math.sqrt
sin = math.sin
cos = math.cos
tan = math.tan
log = math.log
log10 = math.log10
exp = math.exp
pow = math.pow
abs = abs
ceil = math.ceil
floor = math.floor
round = round

# Answer variable for continuation
ans = 0

def help_calc():
    print('''
🧮 Calculator Help:
==================
Basic operators: + - * / ** % //
Functions: sqrt(), sin(), cos(), tan(), log(), log10(), exp()
Constants: pi, e
Examples:
  2 + 3 * 4        → 14
  sqrt(16)         → 4.0
  sin(pi/2)        → 1.0
  2**8             → 256
  log(e)           → 1.0
  * 2              → Multiply last answer by 2
  + 5              → Add 5 to last answer
  
Commands:
  help() or ?      → Show this help
  quit() or q      → Exit calculator
  clear() or c     → Clear screen
  
Results are automatically copied to clipboard!
    ''')

def quit_calc():
    print('Goodbye! 👋')
    sys.exit(0)

def clear_screen():
    os.system('clear')
    print('🧮 Terminal Calculator')
    print('Type help() for commands or an expression to calculate')
    print('Press Ctrl+C or type quit() to exit\\n')

# Add shortcuts
q = quit_calc
c = clear_screen
help = help_calc

# Copy to clipboard function
def copy_to_clipboard(text):
    try:
        if os.environ.get('WAYLAND_DISPLAY'):
            os.system(f'echo \"{text}\" | wl-copy')
        else:
            os.system(f'echo \"{text}\" | xclip -selection clipboard')
        return True
    except:
        return False

# Welcome message
clear_screen()

while True:
    try:
        # Show prompt with current answer if available
        if ans != 0:
            prompt = f'📱 calc[ans={ans}]> '
        else:
            prompt = '📱 calc> '
            
        expr = input(prompt)
        
        if not expr.strip():
            continue
            
        if expr.strip().lower() in ['quit', 'q', 'exit']:
            quit_calc()
        elif expr.strip().lower() in ['clear', 'c', 'cls']:
            clear_screen()
            continue
        elif expr.strip().lower() in ['help', '?']:
            help_calc()
            continue
            
        # Handle answer continuation (expressions starting with operators)
        if expr.strip().startswith(('*', '/', '+', '-', '%', '**')):
            expr = f'ans {expr.strip()}'
            
        # Evaluate the expression
        try:
            result = eval(expr)
            ans = result  # Store result for next calculation
            print(f'✅ {result}')
            
            # Copy result to clipboard
            if copy_to_clipboard(str(result)):
                print('📋 Copied to clipboard!')
            
        except Exception as e:
            print(f'❌ Error: {e}')
            
    except KeyboardInterrupt:
        quit_calc()
    except EOFError:
        quit_calc()
"

# Launch the calculator in a floating terminal
exec alacritty --class "floating-calculator" --title "Calculator" -e python3 -c "$CALC_SCRIPT"

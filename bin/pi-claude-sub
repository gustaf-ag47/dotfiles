#!/bin/bash
# Compatibility shim (2026-09-27): plain `pi` now routes Anthropic through
# claude-token-proxy by itself via the global anthropic-pool extension
# (config/pi/extensions/anthropic-pool.ts, linked by pi-link-extensions), so
# this wrapper has nothing left to add. Kept only so existing loops that call
# `pi-claude-sub` keep working; new scripts should call `pi` directly.
#
# Legacy env knobs (PI_CLAUDE_SUB_PROXY, PI_CLAUDE_SUB_MODEL, …) are ignored;
# use PI_ANTHROPIC_PROXY_URL / CC_PROXY_PORT and pi's own settings instead.
set -euo pipefail
exec "${PI_CLAUDE_SUB_PI_BIN:-pi}" "$@"

#!/bin/bash
# Brightness keys. swayosd (Hyprland) draws the OSD and drives brightnessctl;
# the notify-send path remains for i3/X11.

osd() {
	command -v swayosd-client >/dev/null && pgrep -x swayosd-server >/dev/null || return 1
	swayosd-client "$@" >/dev/null 2>&1
}

get_backlight() {
	# Percentage, not the raw device value: max varies per panel.
	brightnessctl -m | awk -F, '{print $4}' | tr -d '%'
}

notify_user() {
	local brightness

	brightness=$(get_backlight)
	notify-send -h string:x-canonical-private-synchronous:sys-notify -u low "Brightness Level" "Current brightness: ${brightness}%" -i "notification-display-brightness"
}

inc_backlight() {
	osd --brightness +5 && return
	brightnessctl s +5% && notify_user
}

dec_backlight() {
	osd --brightness -5 && return
	brightnessctl s 5%- && notify_user
}

if [[ "$1" == "--get" ]]; then
	get_backlight
elif [[ "$1" == "--inc" ]]; then
	inc_backlight
elif [[ "$1" == "--dec" ]]; then
	dec_backlight
else
	get_backlight
fi

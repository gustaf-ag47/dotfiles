#!/bin/bash

# Setup Git hooks for the current repository
# Links hooks from dotfiles config to local repo

set -e

DOTFILES_HOOKS="${XDG_CONFIG_HOME:-$HOME/.config}/git/hooks"

echo "🔧 Setting up Git hooks..."

# `git rev-parse --git-path` resolves correctly in worktrees too (.git is a file there).
if ! REPO_HOOKS="$(git rev-parse --git-path hooks 2>/dev/null)"; then
    echo "❌ Not in a Git repository"
    exit 1
fi

# Check if dotfiles hooks exist
if [ ! -d "$DOTFILES_HOOKS" ]; then
    echo "❌ Dotfiles hooks not found at $DOTFILES_HOOKS"
    echo "Make sure dotfiles are installed with 'make install'"
    exit 1
fi

# Create hooks directory if it doesn't exist
mkdir -p "$REPO_HOOKS"

# Link each hook
for hook in "$DOTFILES_HOOKS"/*; do
    if [ -f "$hook" ]; then
        hook_name=$(basename "$hook")
        target="$REPO_HOOKS/$hook_name"
        
        # Remove existing hook if it exists
        if [ -f "$target" ] || [ -L "$target" ]; then
            rm "$target"
        fi
        
        # Create symlink with absolute path
        hook_abs_path="$(cd "$(dirname "$hook")" && pwd)/$(basename "$hook")"
        ln -s "$hook_abs_path" "$target"
        chmod +x "$target"
        
        echo "✅ Linked $hook_name hook"
    fi
done

echo ""
echo "🎉 Git hooks setup complete!"
echo ""
echo "Active hooks:"
for hook in "$REPO_HOOKS"/*; do
    if [ -L "$hook" ] && [[ "$(basename "$hook")" != *"sample"* ]]; then
        ls -la "$hook"
    fi
done
echo ""

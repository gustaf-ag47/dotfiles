#!/bin/bash
set -euo pipefail

# File manager launcher with fallbacks.
# Terminal probing is delegated to bin/terminal; keep one fallback chain.

HERE="$(dirname "$(readlink -f "$0")")"

for fm in lf ranger nnn; do
    if command -v "$fm" &>/dev/null; then
        exec "$HERE/terminal" -e "$fm" "$@"
    fi
done

# GUI file managers as fallback
for fm in thunar nautilus dolphin; do
    if command -v "$fm" &>/dev/null; then
        exec "$fm" "$@"
    fi
done

echo "Error: No file manager found" >&2
echo "Please install: lf, ranger, nnn, thunar, nautilus, or dolphin" >&2
exit 1

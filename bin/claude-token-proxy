DEEPSEEK_FALLBACK = os.environ.get("CC_PROXY_DEEPSEEK_FALLBACK", "0") == "1"
# A client that does its own cross-provider failover (pi's llm-failover extension)
# sends `x-cc-proxy-fallback: none` so an exhausted pool surfaces as the normal
# unavailable error instead of a silent DeepSeek answer priced and labelled as Claude.
FALLBACK_OPT_OUT_HEADER = "x-cc-proxy-fallback"

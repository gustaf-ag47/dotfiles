                    or Path(__file__).resolve().parent.parent / "config" / "llm-proxy" / "classes.json")
DEEPSEEK_MIN_BALANCE = float(os.environ.get("CC_PROXY_DEEPSEEK_MIN_BALANCE", "1.0"))
DEEPSEEK_MONTHLY_CAP = float(os.environ.get("CC_PROXY_DEEPSEEK_MONTHLY_CAP", "20"))
DEEPSEEK_SPEND = {"month": datetime.now(timezone.utc).strftime("%Y-%m"), "start_balance": None, "min_balance": None}
STARVED_COUNT = 0

#!/bin/bash
# luks-yubikey -- unlock the encrypted root disk with a FIDO2 YubiKey (PIN + touch).
#
#   sudo luks-yubikey status     what can unlock the disk right now
#   sudo luks-yubikey migrate    switch the boot to sd-encrypt (needed for FIDO2);
#                                the passphrase keeps working
#   sudo luks-yubikey enroll     add a YubiKey; run it again for each key (A, B).
#                                Tests the key right away, without rebooting
#   sudo luks-yubikey recovery   create a recovery key: shown ONCE, write it down;
#                                you type it back to prove it was copied right
#   sudo luks-yubikey require    remove the passphrase, so only a YubiKey or the
#                                recovery key unlocks the disk
#
# Order: enroll (each key) -> reboot once to see the YubiKey prompt -> recovery
# -> require. `require` refuses unless, right then, an enrolled YubiKey unlocks
# the disk AND a recovery key exists AND you type it correctly. Nothing here
# ever removes the last way in.
set -euo pipefail

MAPPER=root
HOOKS_LINE='HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt filesystems fsck)'

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die() { printf '\033[1;31mluks-yubikey: %s\033[0m\n' "$*" >&2; exit 1; }
banner() {
	echo
	printf '\033[1;33m  ┌──────────────────────────────────────────────────────────────\033[0m\n'
	for line in "$@"; do printf '\033[1;33m  │\033[0m %s\n' "$line"; done
	printf '\033[1;33m  └──────────────────────────────────────────────────────────────\033[0m\n'
}

need_root() { [ "$(id -u)" -eq 0 ] || die "run as root: sudo luks-yubikey $*"; }

luks_device() {
	local dev
	dev=$(cryptsetup status "$MAPPER" 2>/dev/null | awk '$1 == "device:" {print $2}')
	[ -n "$dev" ] || die "no LUKS device behind /dev/mapper/$MAPPER"
	echo "$dev"
}

slots_of_type() { # slots_of_type <dev> <password|recovery|fido2>
	systemd-cryptenroll "$1" 2>/dev/null | awk -v t="$2" '$2 == t {n++} END {print n + 0}'
}

uses_sd_encrypt() { grep -q '^HOOKS=.*sd-encrypt' /etc/mkinitcpio.conf; }

backup() {
	local f stamp
	stamp=$(date +%Y%m%d%H%M%S)
	for f in "$@"; do
		[ -e "$f" ] && cp -a "$f" "$f.luks-yubikey.$stamp"
	done
	return 0
}

cmd_status() {
	local dev
	dev=$(luks_device)
	bold "Encrypted root: $dev (/dev/mapper/$MAPPER)"
	if uses_sd_encrypt; then note "boot unlock: sd-encrypt (FIDO2-capable)"; else note "boot unlock: old 'encrypt' hook (run: luks-yubikey migrate)"; fi
	if [ -f /etc/crypttab.initramfs ]; then note "crypttab.initramfs: $(grep -v '^#' /etc/crypttab.initramfs | head -1)"; fi
	note "passphrases: $(slots_of_type "$dev" password)   YubiKeys: $(slots_of_type "$dev" fido2)   recovery keys: $(slots_of_type "$dev" recovery)"
	echo
	systemd-cryptenroll "$dev" | sed 's/^/    /'
}

write_crypttab() {
	local dev uuid opts=luks
	dev=$(luks_device)
	uuid=$(cryptsetup luksUUID "$dev")
	[ "$(slots_of_type "$dev" fido2)" -gt 0 ] && opts="luks,fido2-device=auto"
	printf '# Written by luks-yubikey. sd-encrypt opens the root disk from this file.\n%s UUID=%s none %s\n' \
		"$MAPPER" "$uuid" "$opts" >/etc/crypttab.initramfs
}

cmd_migrate() {
	need_root migrate
	backup /etc/mkinitcpio.conf /etc/default/grub /etc/crypttab.initramfs
	if uses_sd_encrypt; then
		note "initramfs already uses sd-encrypt"
	else
		sed -i "s/^HOOKS=.*/$HOOKS_LINE/" /etc/mkinitcpio.conf
		note "initramfs hooks -> sd-encrypt (systemd)"
	fi
	write_crypttab
	note "crypttab.initramfs -> $(tail -1 /etc/crypttab.initramfs)"
	# sd-encrypt reads crypttab.initramfs; the old encrypt hook's cryptdevice= on
	# the kernel cmdline would make the disk be opened twice. root= stays.
	sed -i -E 's/(^GRUB_CMDLINE_LINUX="[^"]*)cryptdevice=[^ "]*[ ]?/\1/' /etc/default/grub
	bold "Rebuilding the initramfs and GRUB config..."
	mkinitcpio -P >/dev/null
	grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
	bold "Done. Your passphrase works as before; backups: *.luks-yubikey.<time>"
}

ensure_fido2_tools() {
	pacman -Q libfido2 >/dev/null 2>&1 || pacman -S --needed --noconfirm libfido2 >/dev/null
}

cmd_enroll() {
	need_root enroll
	local dev
	dev=$(luks_device)
	ensure_fido2_tools
	systemd-cryptenroll --fido2-device=list 2>/dev/null | grep -q '/dev/' ||
		die "no FIDO2 key found: plug the YubiKey in (and try another port)"
	if command -v ykman >/dev/null && ykman fido info 2>/dev/null | grep -qiE 'PIN:.*not set'; then
		banner "This YubiKey has no FIDO2 PIN yet. Set one now (4-63 characters)."
		ykman fido access change-pin
	fi
	banner "Adding this YubiKey as a way to unlock the disk. You will be asked for:" \
		"1. your CURRENT disk passphrase (or recovery key)" \
		"2. the YubiKey's FIDO2 PIN" \
		"3. a TOUCH when the key blinks"
	systemd-cryptenroll --fido2-device=auto --fido2-with-client-pin=yes \
		--fido2-with-user-presence=yes "$dev"
	banner "Testing it now (no reboot): enter the PIN, then TOUCH the key when it blinks."
	if cryptsetup open --test-passphrase --token-only "$dev"; then
		bold "This YubiKey unlocks the disk."
	else
		die "the key was enrolled but the test failed; keep the passphrase and try 'luks-yubikey enroll' again"
	fi
	cmd_migrate
	note "Enrolled YubiKeys: $(slots_of_type "$dev" fido2). Add your backup key: swap keys and run 'sudo luks-yubikey enroll' again."
	note "Then reboot once: the boot asks for the YubiKey PIN + touch (passphrase still works)."
}

cmd_recovery() {
	need_root recovery
	local dev key
	dev=$(luks_device)
	banner "A recovery key will be shown ONCE. Write it on paper and keep it somewhere safe." \
		"It unlocks the disk if you lose both YubiKeys. You will need the current" \
		"passphrase (or a YubiKey) first."
	systemd-cryptenroll --recovery-key "$dev"
	echo
	read -rsp "Type the recovery key back exactly as you wrote it down: " key
	echo
	if printf '%s' "$key" | cryptsetup open --test-passphrase --key-file - "$dev"; then
		bold "Recovery key checked: it unlocks the disk."
	else
		die "that does not unlock the disk. Check what you wrote down, or create a new one: luks-yubikey recovery"
	fi
}

cmd_require() {
	need_root require
	local dev key
	dev=$(luks_device)
	[ "$(slots_of_type "$dev" password)" -gt 0 ] || { note "no passphrase left; nothing to do"; return 0; }
	[ "$(slots_of_type "$dev" fido2)" -gt 0 ] || die "no YubiKey enrolled yet: sudo luks-yubikey enroll"
	[ "$(slots_of_type "$dev" recovery)" -gt 0 ] || die "no recovery key yet: sudo luks-yubikey recovery"
	if ! uses_sd_encrypt || ! grep -q 'fido2-device=auto' /etc/crypttab.initramfs 2>/dev/null; then
		die "the boot is not set up for the YubiKey yet: sudo luks-yubikey migrate"
	fi
	banner "Before the passphrase goes, both other ways in are tested now." \
		"1/2: enter the YubiKey PIN, then TOUCH the key when it blinks."
	cryptsetup open --test-passphrase --token-only "$dev" ||
		die "the YubiKey did not unlock the disk; the passphrase stays"
	read -rsp "2/2: type your recovery key: " key
	echo
	printf '%s' "$key" | cryptsetup open --test-passphrase --key-file - "$dev" ||
		die "that recovery key does not unlock the disk; the passphrase stays"
	banner "Both work. Removing the passphrase means ONLY a YubiKey (PIN + touch)" \
		"or the recovery key will unlock this disk from now on."
	local typed
	read -rp "Type REMOVE to remove the passphrase: " typed
	[ "$typed" = REMOVE ] || die "not confirmed; nothing changed"
	systemd-cryptenroll --wipe-slot=password "$dev"
	bold "Passphrase removed. The disk now needs a YubiKey (or the recovery key)."
	cmd_status
}

case "${1:-}" in
status) cmd_status ;;
migrate) cmd_migrate ;;
enroll) cmd_enroll ;;
recovery) cmd_recovery ;;
require) cmd_require ;;
-h | --help | "") sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0" ;;
*) die "unknown command: $1 (see luks-yubikey --help)" ;;
esac

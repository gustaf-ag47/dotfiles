#!/bin/bash
set -euo pipefail

# bwf - Bitwarden fuzzy finder: pick a login, copy a field to the clipboard.
#
#   bwf [all|private|<org name>]   open the picker in a scope (default: last used)
#   bwf lock                        forget session + cached vault
#   bwf sync                        refresh the cached vault now
#
# Fast path makes no `bw` call at all: the session token and the decrypted
# item list live in $XDG_RUNTIME_DIR/bwf (tmpfs, 0600, gone at logout/reboot).
# `bw sync` runs in the background after the picker opens, so the next run
# sees today's changes. Only TOTP needs a live `bw` call.
#
# Scope: ~/.config/bwf/scopes maps a scope to Bitwarden folders, one per line:
#     sweetspot: Sweetspot, Work
# "private" is every item in no listed folder; "all" is everything. Ctrl-S in
# the picker cycles the scope; the folder is also a column, so typing its
# name fuzzy-filters too.
#
# Dependencies: bw, jq, fzf, copy (from dotfiles bin/)

CLEAR_SECONDS="${BW_CLEAR_SECONDS:-15}"
CACHE_TTL="${BWF_CACHE_TTL:-43200}"  # seconds before a cached vault is refetched in the foreground
DIR="${XDG_RUNTIME_DIR:-/tmp/bwf-$UID}/bwf"
SESSION_FILE="$DIR/session"
ITEMS_FILE="$DIR/items.json"
FOLDERS_FILE="$DIR/folders.json"
SCOPES_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/bwf/scopes"
SCOPE_FILE="$DIR/scope"

for cmd in bw jq fzf; do
  command -v "$cmd" &>/dev/null || { echo "Error: '$cmd' is not installed." >&2; exit 1; }
done

mkdir -p "$DIR" && chmod 700 "$DIR"

die() { echo "$*" >&2; exit 1; }

# --- session -----------------------------------------------------------------
session() {
  if [[ -s "$SESSION_FILE" ]]; then
    cat "$SESSION_FILE"
    return
  fi
  bw login --check &>/dev/null || die "Not logged in: run 'bw login' first."
  local s
  s="$(bw unlock --raw </dev/tty)" || die "unlock failed"
  (umask 077; printf '%s' "$s" > "$SESSION_FILE")
  printf '%s' "$s"
}

# Run bw with the cached session; on an invalid session, re-unlock once.
bw_s() {
  local s out
  s="$(session)"
  if out="$(bw --session "$s" "$@" 2>/dev/null)"; then
    printf '%s' "$out"
    return
  fi
  rm -f "$SESSION_FILE" "$ITEMS_FILE"
  s="$(session)"
  bw --session "$s" "$@"
}

# write_cache <file> <bw args...>: atomic, 0600, no leftovers on failure
write_cache() {
  local target="$1" tmp; shift
  tmp="$(mktemp -p "$DIR")"
  if "$@" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    chmod 600 "$tmp" && mv -f "$tmp" "$target"
  else
    rm -f "$tmp"; return 1
  fi
}

fetch_vault() {  # foreground, into the cache
  write_cache "$FOLDERS_FILE" bw_s list folders
  write_cache "$ITEMS_FILE" bw_s list items
}

refresh_background() {
  (
    s="$(cat "$SESSION_FILE" 2>/dev/null)" || exit 0
    bw --session "$s" sync &>/dev/null || exit 0
    write_cache "$FOLDERS_FILE" bw --session "$s" list folders
    write_cache "$ITEMS_FILE" bw --session "$s" list items
  ) &>/dev/null &
  disown
}

cache_fresh() {
  [[ -s "$ITEMS_FILE" && -s "$FOLDERS_FILE" ]] || return 1
  local age=$(( $(date +%s) - $(stat -c %Y "$ITEMS_FILE") ))
  (( age < CACHE_TTL ))
}

# --- subcommands -------------------------------------------------------------
case "${1:-}" in
  lock)
    s="$(cat "$SESSION_FILE" 2>/dev/null || true)"
    [[ -n "$s" ]] && bw --session "$s" lock &>/dev/null || true
    rm -rf "$DIR"
    echo "bwf: session and cache cleared."
    exit 0 ;;
  sync)
    bw_s sync >/dev/null && fetch_vault && echo "bwf: vault refreshed."
    exit 0 ;;
  -h|--help)
    sed -n '3,21p' "$0"; exit 0 ;;
esac

# --- scope -------------------------------------------------------------------
cache_fresh || fetch_vault
refresh_background

# Scopes: all, private, then each "<scope>: <folder>, <folder>" line of the config.
declare -A scope_folders=()
scopes=(all private)
if [[ -f "$SCOPES_CONF" ]]; then
  while IFS=: read -r name folders; do
    name="$(tr -d '[:space:]' <<<"$name")"
    [[ -z "$name" || "$name" == \#* ]] && continue
    scope_folders["$name"]="$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/[[:space:]]*,[[:space:]]*/|/g' <<<"$folders")"
    scopes+=("$name")
  done < "$SCOPES_CONF"
fi
if [[ ${#scope_folders[@]} -eq 0 ]]; then
  echo "bwf: no scopes in $SCOPES_CONF - only all/private (see 'bwf --help')" >&2
fi

scope="${1:-$(cat "$SCOPE_FILE" 2>/dev/null || echo all)}"
scope_ok=false
for s in "${scopes[@]}"; do [[ "${s,,}" == "${scope,,}" ]] && scope="$s" && scope_ok=true; done
$scope_ok || die "unknown scope '$scope' (have: ${scopes[*]})"

next_scope() {
  local i
  for i in "${!scopes[@]}"; do
    [[ "${scopes[$i]}" == "$1" ]] && { echo "${scopes[$(( (i + 1) % ${#scopes[@]} ))]}"; return; }
  done
  echo all
}

# id, folder, name, username, first uri - filtered by scope
list_items() {
  local scope="$1" want="" claimed=""
  if [[ -n "${scope_folders[$scope]:-}" ]]; then
    want="^(${scope_folders[$scope]})$"
  elif [[ "$scope" == "private" ]]; then
    claimed="$(IFS='|'; echo "${scope_folders[*]}")"
    claimed="^(${claimed:-__none__})$"
  fi
  jq -r --arg want "$want" --arg claimed "$claimed" --slurpfile folders "$FOLDERS_FILE" '
    ($folders[0] | map(select(.id != null)) | map({key: .id, value: .name}) | from_entries) as $f
    | .[] | select(.type == 1)
    | .folder = (if .folderId then ($f[.folderId] // "?") else "-" end)
    | select(
        ($want == "" and $claimed == "")
        or ($want != "" and (.folder | test($want; "i")))
        or ($claimed != "" and (.folder | test($claimed; "i") | not)))
    | [.id, .folder, .name, (.login.username // ""), (.login.uris[0].uri // "")] | @tsv
  ' "$ITEMS_FILE"
}

# --- pick item (Ctrl-S cycles scope) -----------------------------------------
while :; do
  out="$(list_items "$scope" \
    | fzf --with-nth=2.. --delimiter='\t' --tabstop=1 \
          --header="[$scope]  Ctrl-S: next scope   (folder | name | username | url)" \
          --preview='printf "Folder: %s\nName:  %s\nUser:  %s\nURL:   %s\n" {2} {3} {4} {5}' \
          --preview-window=up:4:wrap --reverse --expect=ctrl-s)" || out=""
  key="${out%%$'\n'*}"
  item="${out#*$'\n'}"
  if [[ "$key" == "ctrl-s" ]]; then
    scope="$(next_scope "$scope")"
    continue
  fi
  break
done
printf '%s' "$scope" > "$SCOPE_FILE"

[[ -n "$item" && "$item" != "$out" ]] || { echo "No item selected."; exit 0; }
item_id="$(cut -f1 <<<"$item")"
details="$(jq -c --arg id "$item_id" '.[] | select(.id == $id)' "$ITEMS_FILE")"

# --- pick field --------------------------------------------------------------
fields=()
field_values=()
add() { fields+=("$1"); field_values+=("$2"); }

username="$(jq -r '.login.username // empty' <<<"$details")"
[[ -n "$username" ]] && add "Username: $username" "$username"

password="$(jq -r '.login.password // empty' <<<"$details")"
[[ -n "$password" ]] && add "Password: ********" "$password"

if [[ -n "$(jq -r '.login.totp // empty' <<<"$details")" ]]; then
  add "TOTP: (generated on copy)" "__TOTP__"
fi

while IFS= read -r uri; do
  [[ -n "$uri" ]] && add "URI: $uri" "$uri"
done < <(jq -r '.login.uris[]?.uri // empty' <<<"$details")

notes="$(jq -r '.notes // empty' <<<"$details")"
[[ -n "$notes" ]] && add "Notes: $(head -1 <<<"$notes" | cut -c1-60)..." "$notes"

while IFS=$'\t' read -r fname ftype fvalue; do
  [[ -n "$fvalue" ]] || continue
  if [[ "$ftype" == "1" ]]; then add "$fname: ********" "$fvalue"; else add "$fname: $fvalue" "$fvalue"; fi
done < <(jq -r '.fields[]? | [(.name // "Field"), (.type|tostring), (.value // "")] | @tsv' <<<"$details")

[[ ${#fields[@]} -gt 0 ]] || { echo "No fields available for this item."; exit 0; }

selected_index="$(printf '%s\n' "${fields[@]}" \
  | nl -ba -w1 -s$'\t' \
  | fzf --with-nth=2.. --delimiter='\t' --header="Select field to copy:" --reverse --height=40% \
  | cut -f1)"
[[ -n "$selected_index" ]] || { echo "No field selected."; exit 0; }

value="${field_values[$((selected_index - 1))]}"
[[ "$value" == "__TOTP__" ]] && value="$(bw_s get totp "$item_id")"

printf '%s' "$value" | copy
echo "Copied to clipboard. Clearing in ${CLEAR_SECONDS}s."
( sleep "$CLEAR_SECONDS"; printf '' | copy; ) &>/dev/null &
disown

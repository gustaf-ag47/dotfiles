#!/bin/bash
# Lock the session. On Wayland, routes through DBus so hypridle intercepts the
# signal and starts hyprlock — keeping a single canonical lock path regardless
# of caller (keybind, idle timeout, lid close, or manual invocation).

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
	loginctl lock-session
else
	i3lock
fi

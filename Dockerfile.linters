FROM alpine:3.19

# Install linters and tools
RUN apk add --no-cache \
    # Shell linters
    shellcheck \
    shfmt \
    bash \
    # Lua linter
    lua5.1 \
    luarocks5.1 \
    gcc \
    musl-dev \
    lua5.1-dev \
    # YAML linter
    yamllint \
    # Git (for hooks)
    git \
    # Other useful tools
    make

# Install luacheck via luarocks
RUN luarocks-5.1 install luacheck

# Create symlinks for lua/luac commands (pre-commit hook calls bare `luac -p`).
# -f: alpine:3.19's lua5.1 package now ships /usr/bin/lua itself, so the bare
# `ln -s` this used to be started failing the image build outright.
RUN ln -sf /usr/bin/lua5.1 /usr/bin/lua && ln -sf /usr/bin/luac5.1 /usr/bin/luac

# Set working directory
WORKDIR /workspace

# Default command - show versions
CMD ["sh", "-c", "echo 'Linters installed:' && \
     echo 'shellcheck:' $(shellcheck --version | head -2 | tail -1) && \
     echo 'shfmt:' $(shfmt -version) && \
     echo 'luacheck:' $(luacheck --version) && \
     echo 'yamllint:' $(yamllint --version)"]

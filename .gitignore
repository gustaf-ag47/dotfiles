config/zsh/.zcompdump
config/zsh/.zhistory
.mcp.json

# Tmux plugins (installed via tpm during make install)
config/tmux/plugins/

# Claude Code local settings
.claude/settings.local.json

# Local/private configurations (personal, company-specific, etc.)
# Now stored in $SYNC/dotfiles-local and symlinked
# See $SYNC/dotfiles-local/README.md for usage
local

# Neovim minimal.lua repro environment (plugin installs for isolated testing)
config/nvim/.repro/

# Syncthing conflict files
*.sync-conflict-*
.sync-conflict-*
config/gui/Wayland/hypr/host.conf

# Claude Code OAuth token store + caches (NEVER commit — contain live tokens)
cctoken
*cctoken*
claude-code-token.env
.credentials.json

# Company/personal-specific files kept on disk (synced via Syncthing) but never
# committed to this PUBLIC repo. Templates (*.example) ARE committed.
config/nvim/lua/dbui_private.lua
.claude/CLAUDE.md
.claude/skills/

# The global ignore file has a broad `*secret*` rule, which excluded this
# repo's secrets/ directory wholesale. That rule is what created the bootstrap
# paradox: the encrypted Syncthing config a new machine needs could never be
# committed, so it only existed inside $SYNC -- which Syncthing had not set up
# yet. Re-include the directory here; secrets/.gitignore then excludes only the
# private key material, so ciphertext and public recipients CAN be committed.
!secrets/
!secrets/**

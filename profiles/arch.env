# arch -- Dell XPS 15, Intel iris + NVIDIA Optimus, 4K internal panel.
PROFILE_CLASS=laptop
PROFILE_HAS_BATTERY=yes
PROFILE_GPU=hybrid

PROFILE_DISK=/dev/nvme0n1
PROFILE_SWAP_GIB=16
PROFILE_HOSTNAME=arch

# Package roles (system/roles/<role>/), applied in order. Review with:
#   scripts/install-system.sh --profile arch --list
PROFILE_ROLES="base desktop xorg dev work personal latex"

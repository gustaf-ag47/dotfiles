# skrubben -- desktop workstation (i9-9900K, RTX, no battery).
PROFILE_CLASS=desktop
# The only power supplies here are a Logitech mouse (hidpp_battery_0) and a
# USB-C PD source, so autodetecting a "battery" gives a misleading waybar module.
PROFILE_HAS_BATTERY=no
PROFILE_GPU=nvidia

PROFILE_DISK=/dev/nvme1n1
PROFILE_SWAP_GIB=16
PROFILE_HOSTNAME=skrubben

# arch-e2e -- throwaway Proxmox VM used to test the installer end to end.
# Disposable by design: qm destroy 990 --purge.
PROFILE_CLASS=laptop
PROFILE_HAS_BATTERY=yes
PROFILE_GPU=intel

# virtio-scsi presents the disk as /dev/sda in this VM.
PROFILE_DISK=/dev/sda
PROFILE_SWAP_GIB=2
PROFILE_HOSTNAME=arch-e2e

# xps14 -- Dell XPS 14 (2026, DA14260). Intel Panther Lake, Xe3 iGPU only
# (no NVIDIA option on this model). Only USB-C/Thunderbolt ports.
# Research and premises: docs/research/machine-profiles-and-xps14.md
PROFILE_CLASS=laptop
PROFILE_HAS_BATTERY=yes
PROFILE_GPU=intel

# Single NVMe slot. Requires BIOS storage mode "AHCI/NVMe", not "RAID On"
# (Intel VMD); install-arch adds the vmd module if VMD is still active.
PROFILE_DISK=/dev/nvme0n1
PROFILE_SWAP_GIB=16
PROFILE_HOSTNAME=xps14

# Package roles (system/roles/<role>/), applied in order. Review with:
#   scripts/install-system.sh --profile xps14 --list
PROFILE_ROLES="base desktop dev work personal"

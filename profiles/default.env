# Fallback profile. Deliberately conservative: assumes a laptop (so battery and
# backlight modules appear) and declares NO disk, so install-arch refuses to
# partition anything until a real profile exists.
PROFILE_CLASS=laptop
PROFILE_HAS_BATTERY=yes
PROFILE_GPU=intel

# install-arch only. No default disk on purpose -- guessing wipes the wrong one.
PROFILE_DISK=
PROFILE_SWAP_GIB=8
PROFILE_HOSTNAME=arch

# mbsync (isync) -- IMAP <-> local Maildir. Linked to ~/.config/isyncrc.
# Maildir lives in $XDG_DATA_HOME/mail, never in $SYNC: mbsync keeps per-folder
# UID state next to the mail, and Syncthing replicas of it corrupt each other.
# Passwords: bin/mail-pass (private overlay or pass), never in this public repo.

# --- iCloud ---------------------------------------------------------------
# https://support.apple.com/en-us/102525 -- IMAP only (no POP), app-specific
# password, IMAP login is the bare local part.
IMAPAccount icloud
Host imap.mail.me.com
Port 993
User gustaf.silver
PassCmd "mail-pass icloud"
TLSType IMAPS
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore icloud-remote
Account icloud

MaildirStore icloud-local
SubFolders Verbatim
Path ~/.local/share/mail/icloud/
Inbox ~/.local/share/mail/icloud/INBOX

Channel icloud
Far :icloud-remote:
Near :icloud-local:
Patterns *
Create Both
Expunge Both
Remove None
SyncState *
CopyArrivalDate yes

# --- iCloud archive (append-only) --------------------------------------------
# A second copy that only ever gains mail: new server messages are pulled,
# but server deletions, flag changes and moves are never applied here. The
# `icloud` mirror above follows the server (deleting there deletes here), so
# this is the copy to keep. Not indexed by notmuch; browse with
# `neomutt -f ~/.local/share/mail-archive/icloud/<folder>`. Seeded with
# hardlinks from the mirror (mail-archive-seed), so it costs no extra disk
# until the two diverge.
MaildirStore icloud-archive-local
SubFolders Verbatim
Path ~/.local/share/mail-archive/icloud/
Inbox ~/.local/share/mail-archive/icloud/INBOX

Channel icloud-archive
Far :icloud-remote:
Near :icloud-archive-local:
Patterns *
Create Near
Sync PullNew
Expunge None
Remove None
SyncState *
CopyArrivalDate yes

# msmtp -- SMTP submission for neomutt. Linked to ~/.config/msmtp/config.
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.local/state/msmtp.log

# iCloud: SMTP login is the FULL address (unlike IMAP), STARTTLS on 587.
account icloud
host smtp.mail.me.com
port 587
tls_starttls on
from gustaf.silver@icloud.com
user gustaf.silver@icloud.com
passwordeval mail-pass icloud

account default : icloud

[Unit]
Description=Back up the append-only mail archive with restic
Documentation=file://%h/sync/src/dotfiles/bin/mail-backup
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/mail-backup backup
TimeoutStartSec=2h

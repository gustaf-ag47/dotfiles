[user]
	email =
	name =
[alias]
	glog = log --all --pretty='format:%d %Cgreen%h%Creset %an - %s' --graph
	# Workflow aliases documented in docs/GIT_WORKFLOW.md. `clean` cannot be an
	# alias (git builtins shadow aliases); the branch cleaner is `git clean-branches`.
	sync = !git checkout master && git pull origin master
	nb = new-branch
	co = checkout
	br = branch
	st = status
	cm = commit -m
	ca = commit --amend
	pushf = push --force-with-lease
	rim = rebase -i master
	ahead = log master..HEAD --oneline
	feat = "!f() { git commit -m \"feat: $1\"; }; f"
	fix = "!f() { git commit -m \"fix: $1\"; }; f"
	docs = "!f() { git commit -m \"docs: $1\"; }; f"
	style = "!f() { git commit -m \"style: $1\"; }; f"
	refactor = "!f() { git commit -m \"refactor: $1\"; }; f"
	test = "!f() { git commit -m \"test: $1\"; }; f"
	chore = "!f() { git commit -m \"chore: $1\"; }; f"
[core]
	pager = delta
	excludesfile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = true
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[init]
	defaultBranch = master
[gpg]
	format = ssh
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

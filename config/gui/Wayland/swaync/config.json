{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-right": 8,
  "control-center-width": 380,
  "control-center-height": 760,
  "fit-to-screen": false,
  "notification-window-width": 360,
  "notification-icon-size": 40,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "image-size": 56,
      "blur": true
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight",
      "min": 5
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "command": "cc-toggle wifi",
          "update-command": "cc-toggle wifi --status"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "command": "cc-toggle bluetooth",
          "update-command": "cc-toggle bluetooth --status"
        },
        {
          "label": "󰛐  Night light",
          "type": "toggle",
          "command": "cc-toggle nightlight",
          "update-command": "cc-toggle nightlight --status"
        },
        {
          "label": "  Caffeine",
          "type": "toggle",
          "command": "cc-toggle caffeine",
          "update-command": "cc-toggle caffeine --status"
        },
        {
          "label": "󰂄  Battery",
          "command": "battery-menu"
        },
        {
          "label": "󰐥  Power",
          "command": "power"
        }
      ]
    }
  }
}

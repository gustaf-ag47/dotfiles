// Desktop overlay. Included by the main waybar config via "include", which
// merges objects with later values winning -- so redefining modules-right here
// replaces the base list.
//
// No battery module: a desktop still exposes power_supply entries for things
// like a wireless mouse (hidpp_battery_0) and USB-C PD, so an unconditional
// battery module shows a misleading percentage that is not the machine's.
{
  "modules-right": ["tray", "cpu", "memory", "disk", "hyprland/language", "network", "bluetooth", "pulseaudio", "custom/claude-usage", "custom/power"]
}

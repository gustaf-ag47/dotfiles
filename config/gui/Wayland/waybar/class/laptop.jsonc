// Laptop overlay: battery module (click -> bin/battery-menu) and keyboard
// backlight keys handle brightness; the OSD (swayosd) shows the level, so no
// backlight module. Power menu is Super+Ctrl+Q (wlogout) or via swaync.
{
  "modules-right": ["tray", "custom/sys", "privacy", "hyprland/language", "network", "bluetooth", "pulseaudio", "battery", "idle_inhibitor", "custom/llm-usage", "custom/notification"]
}

// Laptop overlay: battery pill (click -> bin/battery-menu); brightness keys
// show the level via swayosd so there is no backlight module. Power menu is
// Super+Ctrl+Q (wlogout) or via swaync. Groups are defined in ../config.
{
  "modules-right": ["tray", "group/sys", "group/conn", "group/pwr", "hyprland/language", "custom/notification"]
}

# Ghostty: same look and behaviour as config/gui/alacritty/alacritty.toml.
# tmux does tabs, splits and sessions, so Ghostty's own bindings for those are
# cleared (alt+digits, ctrl+tab and ctrl+enter would otherwise be swallowed).

# Tokyo Night: the bundled theme matches palette 0-15 and fg/bg exactly;
# 16/17 are the extra indexed colours tokyonight.nvim uses.
theme = TokyoNight Night
palette = 16=#ff9e64
palette = 17=#db4b4b

# Font size lives in the machine overlay (class/<class>.conf or
# hosts/<hostname>.conf). Unlike Alacritty, the overlay is read last and wins.
font-family = Hack Nerd Font Mono

# Select-to-copy into the system clipboard, like Alacritty's save_to_clipboard.
copy-on-select = clipboard
# OSC 52 from nvim/tmux (bin/copy): writes are allowed by default; reads too.
clipboard-read = allow

# Hyprland/i3 draw the frame. No close prompt: windows usually hold tmux.
window-decoration = none
confirm-close-surface = false
resize-overlay = never

# bin/terminal opens plain windows in the D-Bus activated instance
# (ghostty +new-window). Keep it running after its last window closes: a
# restart costs ~1s, and a request racing the exiting instance fails with
# NoReply. --class launches pass --quit-after-last-window-closed=true.
quit-after-last-window-closed = false

# Plain SSH (outside tmux): install the xterm-ghostty terminfo on hosts that
# lack it, and fall back to xterm-256color when that fails.
shell-integration-features = ssh-terminfo,ssh-env,no-cursor

keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+shift+comma=reload_config

# Relative to this file's link ($XDG_CONFIG_HOME/ghostty/), not the repo.
config-file = ?../ghostty-host

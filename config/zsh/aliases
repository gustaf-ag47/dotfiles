#!/bin/bash

alias claude='claude --dangerously-skip-permissions'

codex() {
    case "${1:-}" in
        login|logout|mcp|plugin|mcp-server|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|archive|delete|unarchive|features|help)
            command codex "$@"
            ;;
        *)
            command codex --dangerously-bypass-approvals-and-sandbox "$@"
            ;;
    esac
}

alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias glog='git glog'

alias visudo="sudo EDITOR=nvim visudo"
alias gcheat="curl cheat.sh/git"

alias bigf='find / -xdev -type f -size +500M'

alias d='dirs -v'
for index ({1..9}) alias "$index"="cd +${index} > /dev/null"; unset index 

alias l='ls -l'
alias ll='ls -lahF'
alias lls='ls -lahFtr'
alias la='ls -A'
alias lc='ls -CF'

alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'

alias grep="grep -P -i --color=auto"

# Modern CLI tool aliases
if command -v bat &> /dev/null; then
    alias cat='bat --paging=never'
    alias bathelp='bat --help'
fi

if command -v eza &> /dev/null; then
    alias ls='eza --icons'
    alias ll='eza -la --icons --git'
    alias la='eza -a --icons'
    alias lls='eza -la --icons --git --sort=modified'
    alias tree='eza --tree --icons'
fi

# Note: fd is available but NOT aliased to find because they have
# incompatible syntax (fd uses --type, find uses -type). Use fd directly.

if command -v dust &> /dev/null; then
    alias du='dust'
fi

if command -v duf &> /dev/null; then
    alias df='duf'
fi

if command -v procs &> /dev/null; then
    alias ps='procs'
fi

if command -v rg &> /dev/null; then
    alias grep='rg'
fi

# TUI tools
alias lg='lazygit'
alias lzd='lazydocker'

# Neovim profiles (NVIM_APPNAME isolation — separate data/state/cache, same config)
alias nvtest='NVIM_APPNAME=nvim-test nvim'

# Tmux session management
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias tn='ftmuxp'
alias ts='tmux-safe-save'
alias trs="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tmux-resurrect/scripts/restore.sh"
alias tc='find "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect" -name "*.txt" -mtime +7 -delete && echo "Cleaned old resurrect files"'

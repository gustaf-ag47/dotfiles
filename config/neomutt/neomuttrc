# neomutt -- reads the local Maildir that mbsync fills; sends via msmtp.
# Linked to ~/.config/neomutt. Sync: `mail-sync` (or the mail-sync.timer).

# --- identity / sending ----------------------------------------------------
set realname   = "Gustaf Silver"
set from       = "gustaf.silver@icloud.com"
set use_from   = yes
set sendmail   = "msmtp -a icloud"
set sendmail_wait = 0
set editor     = "nvim +/^$ +nohlsearch"
set edit_headers = yes
set charset    = "utf-8"
set send_charset = "us-ascii:utf-8"

# --- mailboxes (iCloud folder names) ----------------------------------------
set mbox_type  = Maildir
set folder     = "~/.local/share/mail/icloud"
set spoolfile  = "+INBOX"
set record     = "+Sent Messages"
set postponed  = "+Drafts"
set trash      = "+Deleted Messages"
# Every synced folder (iCloud keeps old mail in Archive/<year> and
# Archives/<year>, not INBOX), INBOX first, the rest sorted; re-read at start.
mailboxes =INBOX
mailboxes `find ~/.local/share/mail/icloud -mindepth 2 -name cur -type d -printf '%h\n' 2>/dev/null | sed 's|.*/mail/icloud/||' | grep -vx INBOX | sort | sed 's/.*/"=&"/' | tr '\n' ' '`

# --- notmuch (full-text search across every folder) -------------------------
set nm_default_url = "notmuch://$HOME/.local/share/mail"
set nm_query_type  = threads
set nm_record      = no
virtual-mailboxes "All mail" "notmuch://?query=*" "Unread" "notmuch://?query=tag:unread"
macro index \\ "<vfolder-from-query>" "notmuch search"
macro index,pager A "<save-message>=Archive<enter>" "archive"

# --- behaviour ---------------------------------------------------------------
set mail_check = 60
set timeout    = 15
set header_cache     = "~/.cache/neomutt/headers"
set message_cachedir = "~/.cache/neomutt/bodies"
set sort = threads
set sort_aux = reverse-last-date-received
set use_threads = reverse
set mark_old = no
set delete = yes
set quit = ask-yes
set wait_key = no
set pager_index_lines = 10
set pager_context = 3
set pager_stop = yes
set menu_scroll = yes
set tilde = yes
set markers = no
set include = yes
set reply_to = yes
set fast_reply = yes
set forward_format = "Fwd: %s"
set attribution = "On %d, %n wrote:"
set date_format = "%Y-%m-%d %H:%M"
set index_format = "%4C %Z %{%Y-%m-%d %H:%M} %-20.20F %s"
set sidebar_visible = yes
set sidebar_width = 24
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set sidebar_format = "%D%* %?N?%N/?%S"
set mailcap_path = "~/.config/neomutt/mailcap"
auto_view text/html
alternative_order text/plain text/enriched text/html

# --- vim-ish keys -------------------------------------------------------------
bind index,pager g noop
bind index gg first-entry
bind index G  last-entry
bind pager gg top
bind pager G  bottom
bind index,pager \Cd half-down
bind index,pager \Cu half-up
bind index,pager B sidebar-toggle-visible
bind index,pager \Ck sidebar-prev
bind index,pager \Cj sidebar-next
bind index,pager \Co sidebar-open
bind index,pager R group-reply
bind index l display-message
bind pager h exit
bind index h noop
macro index,pager gi "<change-folder>=INBOX<enter>" "inbox"
macro index,pager gs "<change-folder>=Sent Messages<enter>" "sent"
macro index,pager gd "<change-folder>=Drafts<enter>" "drafts"
macro index,pager ga "<change-folder>=Archive<enter>" "archive"
macro index,pager gu "<change-folder>Unread<enter>" "unread (notmuch)"
macro index,pager gA "<change-folder>All mail<enter>" "all mail, every folder (notmuch)"
macro index S "<shell-escape>mail-sync<enter>" "sync now"
macro index,pager \Cb "<pipe-message>urlscan<enter>" "urls"
# Open the message's HTML part in the browser (mailcap -> mail-open).
macro index,pager \Ch "<view-attachments><search>text/html<enter><view-mailcap><exit>" "html in browser"

# --- attachments (v): <Enter> open, s save, | pipe ---------------------------
set attach_save_dir = "~/Downloads"
set attach_format = "%u%D%I %t%4n %T%.40d%> [%.7m/%.10M, %.6e%?C?, %C?, %s] "

# --- colours (terminal palette) ------------------------------------------------
color normal       default default
color indicator    black   cyan
color tree         brightblack default
color index        brightwhite default ~N
color index        yellow  default ~F
color index        red     default ~D
color hdrdefault   cyan    default
color header       brightyellow default "^(From|Subject):"
color quoted       green   default
color quoted1      blue    default
color signature    brightblack default
color sidebar_new  brightwhite default
color status       black   blue


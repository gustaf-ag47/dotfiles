[Unit]
Description=zram swap (24G + 8G, lz4)
DefaultDependencies=no
After=systemd-modules-load.service
Before=swap.target

# 32G of zram in two devices. 24G alone ran at 70-80% just from cold anon of the
# homelab + agents (swappiness 180), so CI bursts pushed it over the 80%
# host-pressure line (93% on 2026-11-07 12:05). At ~2.4:1 lz4 the full 32G
# costs ~13G of the 62G RAM. zram1 is hot-added so the size can grow without a
# swapoff of zram0.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c 'echo 0 > /sys/module/zswap/parameters/enabled; modprobe zram; echo lz4 > /sys/block/zram0/comp_algorithm; echo 24G > /sys/block/zram0/disksize; mkswap -q /dev/zram0; swapon -p 100 /dev/zram0; [ -e /sys/block/zram1 ] || cat /sys/class/zram-control/hot_add >/dev/null; echo lz4 > /sys/block/zram1/comp_algorithm; echo 8G > /sys/block/zram1/disksize; mkswap -q /dev/zram1; swapon -p 100 /dev/zram1'
ExecStop=/usr/bin/sh -c 'swapoff /dev/zram1; echo 1 > /sys/block/zram1/reset; swapoff /dev/zram0; echo 1 > /sys/block/zram0/reset'

[Install]
WantedBy=swap.target

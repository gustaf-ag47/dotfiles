#!/bin/bash
# net-watchdog (skrubben): if the LAN gateway is unreachable for three runs in a
# row (3 min with the timer), assume a VPN/route change has cut the machine off
# and run net-recover. Hermes lives on skrubben and nothing else can reach it
# when its network is gone, so this is the machine's own way back.
set -uo pipefail
STATE=/run/net-watchdog/fails
THRESHOLD=${THRESHOLD:-3}
mkdir -p "$(dirname "$STATE")"
fails=$(cat "$STATE" 2>/dev/null || echo 0)

gw=$(ip route show default | awk '{print $3; exit}')
if [ -n "$gw" ] && ping -c1 -W3 "$gw" >/dev/null 2>&1; then
	[ "$fails" != 0 ] && logger -t net-watchdog -- "gateway $gw back after $fails failure(s)"
	echo 0 > "$STATE"
	exit 0
fi

fails=$((fails + 1)); echo "$fails" > "$STATE"
logger -t net-watchdog -- "gateway ${gw:-<none>} unreachable ($fails/$THRESHOLD)"
if [ "$fails" -ge "$THRESHOLD" ]; then
	logger -t net-watchdog -- "threshold reached: running net-recover"
	/usr/local/bin/net-recover
	echo 0 > "$STATE"
fi
